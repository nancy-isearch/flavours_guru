			$comment = $this->session->data['comment'] ;
			list($data['gift_message'] ,$data['occasion'], $data['card_message'], $data['special_instruction']) = explode("_", $comment);
			//$data['gift_message'] = $this->session->data['comment'];
		} else {
			$data['gift_message'] = '';
			$data['occasion'] = '';
			$dsta['card_message'] = '';
