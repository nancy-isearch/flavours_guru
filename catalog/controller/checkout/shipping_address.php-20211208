			   <td style="padding:5px; font-size:13px; font-family:Arial, Helvetica, sans-serif; border-bottom:1px solid #efefef; border-left:1px solid #efefef;" align="left" valign="middle">'.$cemail.'</td>
			 </tr> 
			</table>';
		$mail->setHtml($msg); 
		//$mail->setText($msg);
