<script type="text/javascript"><!--

function getDate(nowDate){
  var nowDate = new Date(nowDate);
  var datehtml='<input type="text" class="date" id="delDate" name="delivery_date">';
  jQuery(".delDate").remove();
  jQuery(".calender").html(datehtml);
  
  var today = new Date(nowDate.getFullYear(), nowDate.getMonth(), nowDate.getDate(), 0, 0, 0, 0);
  console.log("This is min date"+today);
  $('.date').datetimepicker({
    minDate: today,
    pickTime: false,
  });
  $('.date').datetimepicker('update');
  //Script for timeslot
  $('input[name=delivery_date]').change(function(){
          var oldArr = new Array();
          jQuery('#specifictime').empty();
          var selDate1 = jQuery('#delDate').val();
          var curDate = new Date();
