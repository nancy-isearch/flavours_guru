<script type="text/javascript">

    $("select").change(function(){
      
        filter = [];
        $("#devel_group option").each(function()
          {
           if( $(this).prop('selected')){ filter.push(this.value); };
        });
        
        location = '<?php echo $action; ?>&filter='+ filter.join(',');
         
    }); 

</script>

