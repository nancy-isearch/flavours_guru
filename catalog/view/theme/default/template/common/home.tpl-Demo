    <script>
     $(document).ready(function(){
          var screenwidth = $(window).width();
            if(screenwidth < 767){
              $(".homeFootContent").append("<button id='show'>Read More</button> ");
              $(".homeFootContent").append("<button id='hidetext'>Read Less</button>");
              $("#hidetext").hide();
              $("#show").click(function(){
                $('.homeFootContent').addClass('show');
                $("#show").hide();
                $("#hidetext").show();
              });
              $("#hidetext").click(function(){
                $('.homeFootContent').removeClass('show');
                $("#hidetext").hide();
                $("#show").show();
              });
              
          }
     });
    </script>
    
